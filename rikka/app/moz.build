GeckoProgram(CONFIG["MOZ_APP_NAME"], linkage="standalone")

SOURCES += [
    "ApplicationData.cpp",
    "nsRikkaApp.cpp",
]

LOCAL_INCLUDES += [
    "!/build",
    "/toolkit/xre",
    "/xpcom/base",
    "/xpcom/build",
]

DisableStlWrapping()

if CONFIG["HAVE_CLOCK_MONOTONIC"]:
    OS_LIBS += CONFIG["REALTIME_LIBS"]

DEFINES["APP_VERSION"] = CONFIG["MOZ_APP_VERSION"]

JS_PREFERENCE_PP_FILES += [
    "profile/rikka.js",
]
