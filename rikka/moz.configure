imply_option("--with-app-name", "rikka-gecko")
imply_option("--with-app-basename", "RikkaGecko")
imply_option("MOZ_APP_VENDOR", "Rikka")
imply_option("MOZ_APP_ID", "{ec8030f7-c20a-464f-9b0e-13a3a9e97384}")
imply_option("MOZ_APP_UA_NAME", "Firefox")
imply_option("MOZ_GECKOVIEW_HISTORY", True)
imply_option("MOZ_NORMANDY", False)
imply_option("MOZ_DEVTOOLS", "all")
imply_option("BROWSER_CHROME_URL", "chrome://rikka/content/view.xhtml")


@depends(target)
def check_target(target):
    if target.kernel != "Linux":
        die("rikka builds only for Linux targets")


include("../mobile/shared/moz.configure")
include("../toolkit/moz.configure")

set_config("MOZ_GECKOVIEW", True)


@depends(build_environment.topsrcdir)
@imports(_import="mozpack.path", _as="mozpath")
def package_manifest(topsrcdir):
    return mozpath.join(topsrcdir, "rikka", "installer", "package-manifest.in")


set_config("MOZ_PKG_MANIFEST", package_manifest)
set_config("MOZ_PKG_FATAL_WARNINGS", True)


@depends(moz_app_name, moz_pkg_binpath, moz_pkg_respath)
@imports(_from="mozbuild.packaging", _import="quote_defines")
def package_manifest_defines(app_name, binpath, respath):
    return quote_defines(
        [
            f"-DMOZ_APP_NAME={app_name}",
            f"-DBINPATH={binpath}",
            f"-DRESPATH={respath}",
            "-DJAREXT=",
        ]
    )


set_config("PACKAGE_MANIFEST_DEFINES", package_manifest_defines)
