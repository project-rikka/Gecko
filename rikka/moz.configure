imply_option("--with-app-name", "rikka-gecko")
imply_option("--with-app-basename", "RikkaGecko")
imply_option("MOZ_APP_VENDOR", "Rikka")
imply_option("MOZ_APP_ID", "{ec8030f7-c20a-464f-9b0e-13a3a9e97384}")
imply_option("MOZ_APP_UA_NAME", "Firefox")
imply_option("MOZ_GECKOVIEW_HISTORY", True)
imply_option("MOZ_NORMANDY", False)
imply_option("MOZ_DEVTOOLS", "all")
imply_option("BROWSER_CHROME_URL", "chrome://rikka/content/view.xhtml")


@depends(target)
def check_target(target):
    if target.kernel != "Linux":
        die("rikka builds only for Linux targets")


include("../mobile/shared/moz.configure")
include("../toolkit/moz.configure")

set_config("MOZ_GECKOVIEW", True)
