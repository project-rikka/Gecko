+#include "ScrollAnimationRikkaPhysics.h"
+
+#include <algorithm>
+#include <cmath>
+
+#include "mozilla/StaticPrefs_general.h"
+
+namespace mozilla {
+
+ScrollAnimationRikkaPhysics::ScrollAnimationRikkaPhysics(
+    Drive aDrive, const nsPoint& aStartPos, nscoord aSmallestVisibleIncrement)
+    : mDrive(aDrive),
+      mOmega(std::sqrt(std::max(
+          double(StaticPrefs::general_smoothScroll_rikka_stiffness()), 1e-6))),
+      mRest(std::max(double(aSmallestVisibleIncrement), 1.0) / 2.0),
+      mDestination(aStartPos) {}
+
+ScrollAnimationRikkaPhysics::Axis ScrollAnimationRikkaPhysics::Axis::After(
+    double aOmega, double aSeconds) const {
+  if (aSeconds <= 0.0) {
+    return *this;
+  }
+  const double reach = mVelocity + aOmega * mGap;
+  const double travelled = mGap + reach * aSeconds;
+  const double decay = std::exp(-aOmega * aSeconds);
+  return Axis{travelled * decay, (reach - aOmega * travelled) * decay};
+}
+
+ScrollAnimationRikkaPhysics::State ScrollAnimationRikkaPhysics::At(
+    const TimeStamp& aTime) const {
+  if (!mSince || aTime <= mSince) {
+    return mState;
+  }
+  const double seconds = (aTime - mSince).ToSeconds();
+  return State{mState.mX.After(mOmega, seconds),
+               mState.mY.After(mOmega, seconds)};
+}
+
+void ScrollAnimationRikkaPhysics::Update(const TimeStamp& aTime,
+                                         const nsPoint& aDestination,
+                                         const nsSize& aCurrentVelocity) {
+  State now = At(aTime);
+  if (!mStarted) {
+    now.mX.mVelocity = aCurrentVelocity.width;
+    now.mY.mVelocity = aCurrentVelocity.height;
+    mStarted = true;
+  }
+  const double movedX = double(aDestination.x) - double(mDestination.x);
+  const double movedY = double(aDestination.y) - double(mDestination.y);
+  now.mX.mGap -= movedX;
+  now.mY.mGap -= movedY;
+  if (mDrive == Drive::Impel) {
+    now.mX.mVelocity += mOmega * movedX;
+    now.mY.mVelocity += mOmega * movedY;
+  }
+  mDestination = aDestination;
+  mState = now;
+  if (!mSince || aTime > mSince) {
+    mSince = aTime;
+  }
+}
+
+void ScrollAnimationRikkaPhysics::ApplyContentShift(
+    const CSSPoint& aShiftDelta) {
+  mDestination += CSSPoint::ToAppUnits(aShiftDelta);
+}
+
+nsSize ScrollAnimationRikkaPhysics::VelocityAt(const TimeStamp& aTime) {
+  const State state = At(aTime);
+  return nsSize(NSToCoordRound(state.mX.mVelocity),
+                NSToCoordRound(state.mY.mVelocity));
+}
+
+nsPoint ScrollAnimationRikkaPhysics::PositionAt(const TimeStamp& aTime) {
+  const State state = At(aTime);
+  return nsPoint(NSToCoordRound(double(mDestination.x) + state.mX.mGap),
+                 NSToCoordRound(double(mDestination.y) + state.mY.mGap));
+}
+
+bool ScrollAnimationRikkaPhysics::IsFinished(const TimeStamp& aTime) {
+  const State state = At(aTime);
+  const auto rests = [this](const Axis& aAxis) {
+    return std::abs(aAxis.mGap) < mRest &&
+           std::abs(aAxis.mVelocity) < mOmega * mRest;
+  };
+  return rests(state.mX) && rests(state.mY);
+}
+
+}
