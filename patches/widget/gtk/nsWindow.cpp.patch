+static void SetRikkaScrollDeltas(WidgetWheelEvent& aEvent, double aDeltaX,
+                                 double aDeltaY, bool aContinuous,
+                                 double aScale) {
+  const double pixels =
+      (aContinuous ? kGdkWaylandAxisUnit
+                   : StaticPrefs::general_smoothScroll_rikka_notch()) *
+      aScale;
+  aEvent.mDeltaMode = dom::WheelEvent_Binding::DOM_DELTA_PIXEL;
+  aEvent.mDeltaX = aDeltaX * pixels;
+  aEvent.mDeltaY = aDeltaY * pixels;
+  if (!aContinuous) {
+    aEvent.mWheelTicksX = aDeltaX;
+    aEvent.mWheelTicksY = aDeltaY;
+  }
+  aEvent.mIsNoLineOrPageDelta = true;
+}
