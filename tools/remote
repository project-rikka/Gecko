#!/usr/bin/env bash
source "$(dirname "$0")/common.sh"

profile=${1:-dev}
case $profile in
    dev | release) ;;
    *) echo "usage: tools/remote [dev|release]" >&2; exit 2 ;;
esac

git -C "$ROOT" update-index -q --refresh
if ! git -C "$ROOT" diff --quiet HEAD; then
    echo "commit the working tree first; the runner builds a pushed commit" >&2
    exit 1
fi
commit=$(git -C "$ROOT" rev-parse HEAD)
pushed=false
for _ in 1 2 3 4 5 6; do
    heads=$(git -C "$ROOT" ls-remote --heads origin | cut -f1)
    if [[ $'\n'$heads$'\n' == *$'\n'$commit$'\n'* ]]; then
        pushed=true
        break
    fi
    sleep 5
done
if ! $pushed; then
    echo "push $commit first; the runner clones it from origin" >&2
    exit 1
fi
repository=$(git -C "$ROOT" remote get-url origin)

work=/home/buildbuddy/gecko
script="RIKKA_GECKO_WORK=$work RIKKA_GECKO_PROFILE=$profile tools/build && RIKKA_GECKO_WORK=$work tools/package \"\$BUILDBUDDY_ARTIFACTS_DIRECTORY\""

request=$(jq -n --arg repository "$repository" --arg commit "$commit" --arg script "$script" '{
    repo: $repository,
    branch: "main",
    commit_sha: $commit,
    steps: [{run: $script}],
    env: {GIT_REPO_DEFAULT_BRANCH: "main"},
    platform_properties: {
        "container-image": "docker://gcr.io/flame-public/rbe-ubuntu24-04:latest",
        "recycle-runner": "true",
        "EstimatedCPU": "32",
        "EstimatedMemory": "64GB",
        "EstimatedFreeDiskBytes": "90GB"
    },
    timeout: "5h",
    wait_until: "STARTED"
}')

invocation=$(buildbuddy Run "$request" | jq -r .invocationId)
echo "https://app.buildbuddy.io/invocation/$invocation"

page=""
while :; do
    status=$(buildbuddy GetInvocation "$(jq -n --arg id "$invocation" '{selector: {invocation_id: $id}}')" \
        | jq -r '.invocation[0].invocationStatus // ""')
    while :; do
        log=$(buildbuddy GetLog "$(jq -n --arg id "$invocation" --arg page "$page" '{selector: {invocation_id: $id}, page_token: $page}')")
        printf '%s' "$(jq -r '.log.contents // ""' <<< "$log")"
        next=$(jq -r '.nextPageToken // ""' <<< "$log")
        [[ -z $next || $next == "$page" ]] && break
        page=$next
    done
    [[ $status == COMPLETE_INVOCATION_STATUS ]] && break
    sleep 15
done

exec "$ROOT/tools/artifact" "$invocation"
