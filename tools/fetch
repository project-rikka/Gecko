#!/usr/bin/env bash
source "$(dirname "$0")/common.sh"

if [[ ! -d $TREE/.git ]]; then
    mkdir -p "$TREE"
    git -C "$TREE" init -q
    git -C "$TREE" remote add origin "$FIREFOX_REPOSITORY"
fi

if [[ $(git -C "$TREE" rev-parse --verify -q 'HEAD^{commit}' || true) != "$FIREFOX_COMMIT" ]]; then
    git -C "$TREE" fetch --depth=1 --no-tags origin "$FIREFOX_COMMIT"
    git -C "$TREE" checkout -q --force --detach FETCH_HEAD
    git -C "$TREE" reflog expire --expire=now --all
    git -C "$TREE" gc -q --prune=now
    rm -f "$WORK/applied"
fi
