#!/usr/bin/env bash
source "$(dirname "$0")/common.sh"

missing=()
for tool in rsync zstd; do
    command -v "$tool" > /dev/null || missing+=("$tool")
done
if (( ${#missing[@]} )); then
    sudo apt-get update -q
    sudo apt-get install -y -q "${missing[@]}"
fi

"$ROOT/tools/assemble"

cd "$TREE"
bootstrapped="$MOZBUILD_STATE_PATH/rikka-bootstrapped-$FIREFOX_COMMIT"
if [[ ! -f $bootstrapped ]]; then
    ./mach --no-interactive bootstrap --application-choice "Firefox for Desktop"
    touch "$bootstrapped"
fi

rust=$(awk -v quote="'" '
    /^[^ ].*:$/ { channel = "" }
    /--channel/ { split($0, field, quote); channel = field[4] }
    /toolchain-alias: linux64-rust-toolchain$/ { print channel; exit }
' taskcluster/kinds/toolchain/rust.yml)
if [[ -z $rust ]]; then
    echo "found no linux64-rust-toolchain channel in taskcluster/kinds/toolchain/rust.yml" >&2
    exit 1
fi
rustup toolchain install "$rust" --profile minimal
export RUSTUP_TOOLCHAIN=$rust

./mach build
