#!/usr/bin/env bash
source "$(dirname "$0")/common.sh"

"$ROOT/tools/fetch"

mapfile -t patches < <(cd "$ROOT/patches" && find . -name '*.patch' -type f | sort)

applied=$( { echo "$FIREFOX_COMMIT"; for patch in "${patches[@]}"; do cat "$ROOT/patches/$patch"; done; } | sha256sum | cut -d' ' -f1)
if [[ $(cat "$WORK/applied" 2>/dev/null || true) != "$applied" ]]; then
    git -C "$TREE" reset -q --hard
    git -C "$TREE" clean -q -fdx
    for patch in "${patches[@]}"; do
        git -C "$TREE" apply --whitespace=nowarn "$ROOT/patches/$patch"
    done
    echo "$applied" > "$WORK/applied"
fi

rsync -a --delete --exclude /config/ "$ROOT/rikka/" "$TREE/rikka/"
mkdir -p "$TREE/rikka/config"
cp -p "$TREE/browser/config/version.txt" "$TREE/browser/config/version_display.txt" "$TREE/rikka/config/"
